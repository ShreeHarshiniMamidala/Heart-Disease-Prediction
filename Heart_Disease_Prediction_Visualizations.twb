    <worksheet name='Gender Analysis'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='fkGroteskNeue,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica Neue,Arial,Noto Sans,sans-serif,Apple Color Emoji,Segoe UI Emoji,Segoe UI Symbol,Noto Color Emoji,Hiragino Sans,PingFang SC,Apple SD Gothic Neo,Yu Gothic,Microsoft YaHei,Microsoft JhengHei,Meiryo' fontsize='16'>Heart Disease Distribution by Gender</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='fkGroteskNeue,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica Neue,Arial,Noto Sans,sans-serif,Apple Color Emoji,Segoe UI Emoji,Segoe UI Symbol,Noto Color Emoji,Hiragino Sans,PingFang SC,Apple SD Gothic Neo,Yu Gothic,Microsoft YaHei,Microsoft JhengHei,Meiryo' fontsize='16'>Stacked bar chart comparing heart disease prevalence between male and female patients. The dataset contains 206 male patients and 97 female patients, reflecting typical cardiovascular study demographics.    </run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='heart_disease_cleaned' name='federated.0e7is3k0e0twr11ffw2h81izn9k7' />
          </datasources>
          <datasource-dependencies datasource='federated.0e7is3k0e0twr11ffw2h81izn9k7'>
            <column caption='Record Count' datatype='integer' name='[Calculation_1464232841232990210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column-instance column='[Calculation_1464232841232990210]' derivation='Sum' name='[cum:sum:Calculation_1464232841232990210:qk]' pivot='key' type='quantitative'>
              <table-calc aggregation='Sum' ordering-type='Rows' type='CumTotal' />
            </column-instance>
            <column-instance column='[sex_label]' derivation='None' name='[none:sex_label:nk]' pivot='key' type='nominal' />
