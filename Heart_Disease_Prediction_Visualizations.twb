  <worksheets>
    <worksheet name='Age Distribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='fkGroteskNeue,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica Neue,Arial,Noto Sans,sans-serif,Apple Color Emoji,Segoe UI Emoji,Segoe UI Symbol,Noto Color Emoji,Hiragino Sans,PingFang SC,Apple SD Gothic Neo,Yu Gothic,Microsoft YaHei,Microsoft JhengHei,Meiryo' fontsize='16'>Age Distribution of Patients by Disease Status</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='fkGroteskNeue,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica Neue,Arial,Noto Sans,sans-serif,Apple Color Emoji,Segoe UI Emoji,Segoe UI Symbol,Noto Color Emoji,Hiragino Sans,PingFang SC,Apple SD Gothic Neo,Yu Gothic,Microsoft YaHei,Microsoft JhengHei,Meiryo' fontsize='13'>Histogram showing the age distribution of patients grouped by disease status with 5-year age bins. The dataset includes patients aged 29 to 77 years, with the highest concentration between ages 50-60. Patients with heart disease (red bars) show a notably higher frequency in the 55-60 age range, suggesting age is a significant risk factor. The distribution reveals that heart disease prevalence increases with age, particularly after age 50. Green bars represent patients without disease, while red bars indicate diagnosed cases. This visualization supports the hypothesis that cardiovascular risk escalates with advancing age</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='heart_disease_cleaned' name='federated.0e7is3k0e0twr11ffw2h81izn9k7' />
          </datasources>
          <datasource-dependencies datasource='federated.0e7is3k0e0twr11ffw2h81izn9k7'>
            <column aggregation='None' caption='Age (bin)' datatype='integer' name='[Age (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='0' formula='[age]' peg='0' size='5' />
            </column>
            <column caption='Record Count' datatype='integer' name='[Calculation_1464232841232990210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Age' datatype='real' name='[age]' role='measure' type='quantitative' />
            <column-instance column='[Age (bin)]' derivation='None' name='[none:Age (bin):ok]' pivot='key' type='ordinal' />
            <column-instance column='[target_label]' derivation='None' name='[none:target_label:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1464232841232990210]' derivation='Sum' name='[sum:Calculation_1464232841232990210:qk]' pivot='key' type='quantitative' />
